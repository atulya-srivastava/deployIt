# API Server Configuration
PORT=9000
SOCKET_PORT=9002

# Redis Connection URL (Pub/Sub & SSE log streaming)
REDIS_URL=redis://localhost:6379

# Apache Kafka Ingestion Pipeline (Aiven Kafka or Local Kafka)
KAFKA_BROKERS=kafka-xxx.aivencloud.com:24134
KAFKA_TOPIC=container-logs
KAFKA_CLIENT_ID=api-server-consumer
KAFKA_GROUP_ID=log-consumers
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your_aiven_kafka_password
KAFKA_SASL_MECHANISM=scram-sha-256

# Aiven ClickHouse Log Storage (Historical Retention)
CLICKHOUSE_HOST=https://clickhouse-xxx.aivencloud.com:24136
CLICKHOUSE_USER=avnadmin
CLICKHOUSE_PASSWORD=your_aiven_clickhouse_password
CLICKHOUSE_DATABASE=default

# AWS Credentials & Region
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# AWS ECS Configuration
ECS_CLUSTER=arn:aws:ecs:ap-south-1:123456789012:cluster/builder-cluster
ECS_TASK_DEFINITION=arn:aws:ecs:ap-south-1:123456789012:task-definition/builder-task
CONTAINER_NAME=builder-image

# VPC Subnets (Comma-separated) & Security Groups
ECS_SUBNETS=subnet-0123456789abcdef0,subnet-0feabcd9876543210
ECS_SECURITY_GROUPS=sg-0123456789abcdef0

# S3 Bucket Name to be passed to builder task
S3_BUCKET_NAME=my-vercel-clone-outputs
